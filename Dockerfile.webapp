# ──────────────────────────────────────────────────────────────────────────────
# Dockerfile para Railway — Browser Use Web App
# Base: python:3.12-slim (Debian trixie) — paquetes con sufijo t64
# ──────────────────────────────────────────────────────────────────────────────
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive \
    IN_DOCKER=true \
    HEADLESS=true \
    PATH="/app/.venv/bin:/bin/uv:$PATH"

# ── Instalar dependencias del sistema + Google Chrome ────────────────────────
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
        wget gnupg ca-certificates curl \
        libglib2.0-0t64 \
        libnss3 \
        libnspr4 \
        libatk1.0-0t64 \
        libatk-bridge2.0-0t64 \
        libcups2t64 \
        libdrm2 \
        libdbus-1-3 \
        libexpat1 \
        libxcb1 \
        libxkbcommon0 \
        libx11-6 \
        libxcomposite1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxrandr2 \
        libgbm1 \
        libpango-1.0-0 \
        libcairo2 \
        libasound2t64 \
        libatspi2.0-0 \
        fonts-liberation \
        fonts-noto-core \
    && install -d -m 0755 /etc/apt/keyrings \
    && wget -qO- https://dl.google.com/linux/linux_signing_key.pub \
       | gpg --dearmor -o /etc/apt/keyrings/google-chrome.gpg \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/google-chrome.gpg] \
         http://dl.google.com/linux/chrome/deb/ stable main" \
         > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update -qq \
    && apt-get install -y --no-install-recommends google-chrome-stable \
    && apt-get clean && rm -rf /var/lib/apt/lists/* \
    && google-chrome-stable --version

# ── uv ────────────────────────────────────────────────────────────────────────
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# ── Código ────────────────────────────────────────────────────────────────────
WORKDIR /app

# Copiar TODO el código (incluyendo pyproject.toml)
COPY . .

# Preparar estructura si es necesario (browser_use/ debe estar en raíz)
# Si browser_use/ no existe en raíz pero existe en browser-use-main/, copiar
RUN if [ ! -d "/app/browser_use" ] && [ -d "/app/browser-use-main/browser_use" ]; then \
        echo "📦 Copiando browser_use/ desde browser-use-main..."; \
        cp -r /app/browser-use-main/browser_use /app/browser_use; \
    elif [ -d "/app/browser_use" ]; then \
        echo "✅ browser_use/ ya existe"; \
    else \
        echo "⚠️ browser_use/ no encontrada, pero proseguimos (puede estar en pyproject.toml)"; \
    fi

# Instalar todas las dependencias + paquete local (browser-use)
# NO usar --no-install-project ya que necesitamos instalar el browser-use local
RUN uv sync

# ── Carpetas necesarias ────────────────────────────────────────────────────────
RUN mkdir -p /app/web_app/uploads

# Verificar que Chrome y Python funcionan
RUN google-chrome-stable --version && \
    python -c "import sys; print(f'✅ Python {sys.version}')"

# ── Arranque ──────────────────────────────────────────────────────────────────
EXPOSE 8000
CMD ["sh", "-c", "cd /app/web_app && uvicorn app:app --host 0.0.0.0 --port ${PORT:-8000}"]
